---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  section: string;
}

const { title, section } = Astro.props;

const nav = [
  { label: 'Getting Started', href: '/docs/',               id: 'getting-started', group: null },
  { label: 'Client Libraries', href: null,                  id: null,              group: 'header' },
  { label: 'Node.js',         href: '/docs/node/',          id: 'node',            group: 'client' },
  { label: 'NestJS',          href: '/docs/nestjs/',         id: 'nestjs',          group: 'client' },
  { label: 'PHP',             href: '/docs/php/',            id: 'php',             group: 'client' },
  { label: 'Laravel',         href: '/docs/laravel/',          id: 'laravel',          group: 'client' },
  { label: 'Python',          href: '/docs/python/',           id: 'python',           group: 'client' },
  { label: 'HTTP API',        href: '/docs/http-api/',         id: 'http-api',         group: null },
  { label: 'Configuration',   href: '/docs/configuration/',    id: 'configuration',    group: null },
  { label: 'SSH Tunnel',      href: '/docs/ssh/',              id: 'ssh',              group: null },
  { label: 'Troubleshooting', href: '/docs/troubleshooting/',  id: 'troubleshooting',  group: null },
];

const pages = nav.filter(n => n.href);
const currentIndex = pages.findIndex(n => n.id === section);
const prevPage = currentIndex > 0 ? pages[currentIndex - 1] : null;
const nextPage = currentIndex < pages.length - 1 ? pages[currentIndex + 1] : null;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Fanar Docs</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@700;800&display=swap" rel="stylesheet" />
  <script is:inline>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.add('light');
    }
  </script>
</head>
<body>
  <div class="max-w-[1400px] mx-auto border-x border-[var(--border)]">
    <Nav />
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-56 shrink-0 border-r border-[var(--border)] sticky top-12 self-start h-[calc(100vh-3rem)] overflow-y-auto">
        <div class="px-6 py-6">
          <div class="text-[var(--accent-text)] text-xs font-mono mb-5 tracking-wide">Docs</div>
          <nav class="flex flex-col gap-0.5">
            {nav.map(item => (
              item.group === 'header' ? (
                <div class="text-[var(--text-ghost)] text-[10px] font-mono px-3 pt-4 pb-1 tracking-widest uppercase">
                  {item.label}
                </div>
              ) : (
                <a
                  href={item.href}
                  class={`text-xs font-mono px-3 py-2 transition-colors ${
                    item.group === 'client' ? 'pl-5' : ''
                  } ${
                    section === item.id
                      ? 'text-[var(--text)] bg-[var(--bg-selected)] border-l-2 border-[#7c3aed] -ml-px'
                      : 'text-[var(--text-dim)] hover:text-[var(--text)]'
                  }`}
                >
                  {item.label}
                </a>
              )
            ))}
          </nav>
        </div>
      </aside>

      <!-- Content -->
      <main class="flex-1 min-w-0 px-10 lg:px-16 py-12 docs-content">
        <slot />

        {(prevPage || nextPage) && (
          <div class="flex items-center justify-between mt-16 pt-8 border-t border-[var(--border)]">
            <div>
              {prevPage && (
                <a href={prevPage.href} class="flex items-center gap-3 group">
                  <span class="text-[var(--text-ghost)] group-hover:text-[var(--text)] transition-colors font-mono text-sm">←</span>
                  <div>
                    <div class="text-[var(--text-ghost)] text-[10px] font-mono uppercase tracking-widest mb-0.5">Previous</div>
                    <div class="text-[var(--text-dim)] group-hover:text-[var(--text)] transition-colors font-mono text-sm">{prevPage.label}</div>
                  </div>
                </a>
              )}
            </div>
            <div>
              {nextPage && (
                <a href={nextPage.href} class="flex items-center gap-3 group text-right">
                  <div>
                    <div class="text-[var(--text-ghost)] text-[10px] font-mono uppercase tracking-widest mb-0.5">Next</div>
                    <div class="text-[var(--text-dim)] group-hover:text-[var(--text)] transition-colors font-mono text-sm">{nextPage.label}</div>
                  </div>
                  <span class="text-[var(--text-ghost)] group-hover:text-[var(--text)] transition-colors font-mono text-sm">→</span>
                </a>
              )}
            </div>
          </div>
        )}
      </main>
    </div>
    <Footer />
  </div>
</body>
</html>

<script>
  document.querySelectorAll('.docs-content pre').forEach(pre => {
    const btn = document.createElement('button');
    btn.textContent = 'copy';
    btn.className = 'copy-btn';
    btn.addEventListener('click', () => {
      const code = pre.querySelector('code');
      navigator.clipboard.writeText(code ? code.innerText : pre.innerText).then(() => {
        btn.textContent = 'copied!';
        setTimeout(() => { btn.textContent = 'copy'; }, 1500);
      });
    });
    pre.style.position = 'relative';
    pre.appendChild(btn);
  });
</script>

<style is:global>
  .docs-content h1 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .docs-content h2 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .docs-content h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent-text);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .docs-content p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .docs-content ul {
    margin-bottom: 1rem;
    padding-left: 0;
    list-style: none;
  }
  .docs-content ul li {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: 0.2rem 0;
    padding-left: 1.25rem;
    position: relative;
  }
  .docs-content ul li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--border-mid);
  }
  .docs-content code:not(pre code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--green);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 0.1rem 0.4rem;
  }
  .docs-content pre {
    background: #080808 !important;
    border: 1px solid #222;
    padding: 1.25rem 1.5rem !important;
    margin: 1rem 0 1.5rem;
    overflow-x: auto;
  }
  .docs-content pre code {
    background: transparent !important;
    font-size: 0.75rem;
  }
  .docs-content .lead {
    font-size: 0.9rem;
    color: var(--text-dim);
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .docs-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.8rem;
    font-family: 'JetBrains Mono', monospace;
  }
  .docs-content th {
    text-align: left;
    color: var(--text-faint);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 1rem 0.5rem 0;
  }
  .docs-content td {
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.6rem 1rem 0.6rem 0;
    vertical-align: top;
  }
  .docs-content td:first-child {
    color: var(--green);
  }
  .docs-content pre .copy-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: #444;
    background: transparent;
    border: 1px solid #333;
    padding: 0.15rem 0.5rem;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .docs-content pre .copy-btn:hover {
    color: #fff;
    border-color: #555;
  }
  .docs-content .badge {
    display: inline-block;
    font-size: 0.65rem;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-faint);
    border: 1px solid var(--border);
    padding: 0.1rem 0.4rem;
    margin-right: 0.25rem;
  }
</style>
