---
---
<nav class="border-b border-[#222] sticky top-0 z-50 bg-black/90 backdrop-blur-sm">
  <div class="flex items-center justify-between h-12">
    <a href="/" class="flex items-center px-6 border-r border-[#222] h-full w-56 shrink-0">
      <img src="/logo-text.png" alt="Fanar" width="225" height="48" class="h-8 w-auto" style="image-rendering: pixelated;" />
    </a>
    <div class="flex items-center h-full">
      <a
        href="/docs/"
        class="flex items-center gap-2 px-5 h-full border-l border-[#222] text-xs font-mono text-[#555] hover:text-white transition-colors"
      >
        <i class="hn hn-book text-sm"></i>
        Docs
      </a>
      <a
        href="https://github.com/fanar-app/fanar-app"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-5 h-full border-l border-[#222] text-xs font-mono text-[#555] hover:text-white transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
        </svg>
        <span id="star-count">Star</span>
      </a>
      <a
        href="#downloads"
        class="flex items-center gap-2 px-5 h-full border-l border-[#222] text-xs font-mono font-bold text-black bg-white hover:bg-[#7c3aed] hover:text-white transition-colors"
      >
        <i class="hn hn-download text-sm"></i>
        Download
      </a>
    </div>
  </div>
</nav>

<script>
  fetch('https://api.github.com/repos/fanar-app/fanar-app')
    .then(r => r.json())
    .then(data => {
      const el = document.getElementById('star-count');
      if (el && typeof data.stargazers_count === 'number') {
        el.textContent = `★ ${data.stargazers_count.toLocaleString()}`;
      }
    })
    .catch(() => {});
</script>
