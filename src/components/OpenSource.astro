---
const items = [
  'No telemetry or analytics',
  'No account required',
  'No paywalls or seat licenses',
  'MIT License — use it anywhere',
  'Source available on GitHub',
  'Self-hosted, no cloud dependency',
];
---
<section class="border-b border-[var(--border)] p-10 lg:p-16">
  <div class="text-[var(--accent-text)] text-xs font-mono mb-4">&lt; Open source &gt;</div>

  <h2 class="text-4xl lg:text-5xl font-bold text-[var(--text)] leading-tight mb-6">
    MIT Licensed.<br />Free Forever.
  </h2>

  <p class="text-[var(--text-faint)] text-sm font-mono leading-relaxed mb-8 max-w-lg">
    No telemetry. No paywalls. No seat licenses.
    Built in the open. If it helps you, star it.
  </p>

  <div class="flex items-center gap-3 flex-wrap mb-12">
    <a
      href="https://github.com/fanar-app/fanar"
      target="_blank"
      rel="noopener noreferrer"
      class="border border-[var(--text)] px-5 py-2.5 text-[var(--bg)] bg-[var(--text)] font-mono text-sm font-bold hover:bg-transparent hover:text-[var(--text)] transition-colors"
    >
      ★ Star on GitHub
    </a>
    <a
      href="https://github.com/fanar-app/fanar"
      target="_blank"
      rel="noopener noreferrer"
      class="border border-[var(--border-mid)] px-5 py-2.5 text-[var(--text)] font-mono text-sm hover:border-[var(--text)] transition-colors"
    >
      Read the source →
    </a>
  </div>

  <div class="grid md:grid-cols-3 gap-3">
    {items.map(item => (
      <div class="flex items-center gap-3 border border-[var(--border)] px-5 py-3 font-mono text-sm text-[var(--text-muted)]">
        <span class="text-[var(--green)] shrink-0">✓</span>
        {item}
      </div>
    ))}
  </div>
</section>
