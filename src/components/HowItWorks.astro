---
const steps = [
  {
    num: '01',
    title: 'Install the client',
    code: 'npm install @fanar-app/fanar',
    desc: 'One package. Zero config for NestJS and Laravel.',
  },
  {
    num: '02',
    title: 'Send any value',
    code: 'fanar({ user, orders })',
    desc: 'Objects, errors, SQL queries, timers — all supported.',
  },
  {
    num: '03',
    title: 'Watch it appear',
    code: '← real-time, no refresh',
    desc: 'Payloads stream to the desktop app the moment they arrive.',
  },
];
---

<section class="border-b border-[var(--border)]">
  <div class="border-b border-[var(--border)] px-10 lg:px-16 py-10">
    <div class="text-[var(--accent-text)] text-xs font-mono mb-4">&lt; How it works &gt;</div>
    <h2 class="text-4xl lg:text-5xl font-bold text-[var(--text)] leading-tight">
      Three Steps.<br />Full Visibility.
    </h2>
  </div>
  <div class="grid md:grid-cols-3">
    {steps.map((step, i) => (
      <div class={`p-10 lg:p-12 ${i < steps.length - 1 ? 'border-r border-[var(--border)]' : ''}`}>
        <div class="text-xs font-mono text-[var(--accent-text)] mb-6">{step.num}</div>
        <h3 class="text-lg font-bold text-[var(--text)] font-mono mb-4">{step.title}</h3>
        <code class="block text-xs text-[var(--green)] font-mono bg-[var(--bg-card)] border border-[var(--border)] px-3 py-2">
          {step.code}
        </code>
      </div>
    ))}
  </div>
</section>
