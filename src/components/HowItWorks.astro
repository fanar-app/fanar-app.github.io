---
const steps = [
  {
    num: '01',
    title: 'Install the client',
    code: 'npm install fanar',
    desc: 'One package. Zero config for NestJS and Laravel.',
  },
  {
    num: '02',
    title: 'Send any value',
    code: 'fanar({ user, orders })',
    desc: 'Objects, errors, SQL queries, timers — all supported.',
  },
  {
    num: '03',
    title: 'Watch it appear',
    code: '← real-time, no refresh',
    desc: 'Payloads stream to the desktop app the moment they arrive.',
  },
];
---

<section class="border-b border-[#222]">
  <div class="border-b border-[#222] px-10 lg:px-16 py-10">
    <div class="text-[#a78bfa] text-xs font-mono mb-4">&lt; How it works &gt;</div>
    <h2 class="text-4xl lg:text-5xl font-bold text-white leading-tight">
      Three Steps.<br />Full Visibility.
    </h2>
  </div>
  <div class="grid md:grid-cols-3">
    {steps.map((step, i) => (
      <div class={`p-10 lg:p-12 ${i < steps.length - 1 ? 'border-r border-[#222]' : ''}`}>
        <div class="text-xs font-mono text-[#a78bfa] mb-6">{step.num}</div>
        <h3 class="text-lg font-bold text-white font-mono mb-4">{step.title}</h3>
        <code class="block text-xs text-[#4ade80] font-mono bg-[#080808] border border-[#222] px-3 py-2">
          {step.code}
        </code>
      </div>
    ))}
  </div>
</section>
