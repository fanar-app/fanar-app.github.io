---
---
<section class="border-b border-[var(--border)]">
  <div class="border-b border-[var(--border)] px-10 lg:px-16 py-10">
    <div class="text-[var(--accent-text)] text-xs font-mono mb-4">&lt; Zero-config integration &gt;</div>
    <h2 class="text-4xl lg:text-5xl font-bold text-[var(--text)] leading-tight">
      One Import.<br />Everything Automatic.
    </h2>
  </div>
  <div class="grid md:grid-cols-2">
    <div class="border-r border-[var(--border)] p-10 lg:p-12">
      <div class="text-xs font-mono text-[var(--text-faint)] mb-5 tracking-wide">NestJS</div>
      <pre class="text-sm font-mono leading-relaxed overflow-x-auto bg-[#080808] border border-[#222] p-5"><code><span class="text-[#555]">// app.module.ts</span>
<span class="text-[#a78bfa]">import</span> <span class="text-white">&#123; FanarModule &#125;</span> <span class="text-[#a78bfa]">from</span> <span class="text-[#4ade80]">'fanar/nestjs'</span>

<span class="text-white">@Module(&#123;</span>
  <span class="text-white">imports: [FanarModule.register()]</span>
<span class="text-white">&#125;)</span>
<span class="text-[#a78bfa]">export class</span> <span class="text-white">AppModule &#123;&#125;</span></code></pre>
    </div>
    <div class="p-10 lg:p-12">
      <div class="text-xs font-mono text-[var(--text-faint)] mb-5 tracking-wide">Laravel</div>
      <pre class="text-sm font-mono leading-relaxed overflow-x-auto bg-[#080808] border border-[#222] p-5"><code><span class="text-[#555]">// config/app.php</span>
<span class="text-white">'providers'</span> <span class="text-[#555]">=&gt;</span> <span class="text-white">[</span>
  <span class="text-[#4ade80]">FanarServiceProvider</span><span class="text-white">::class,</span>
<span class="text-white">],</span>

<span class="text-[#555]">// .env</span>
<span class="text-white">FANAR_HOST=127.0.0.1</span>
<span class="text-white">FANAR_PORT=9913</span></code></pre>
    </div>
  </div>
  <div class="border-t border-[var(--border)] px-10 lg:px-16 py-5">
    <p class="text-xs font-mono text-[var(--text-faint)]">Every request, query, and exception captured. No handlers to touch.</p>
  </div>
</section>
