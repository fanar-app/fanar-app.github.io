---
---
<section class="grid lg:grid-cols-[2fr_3fr] border-b border-[#222] min-h-[88vh]">
  <!-- Left cell -->
  <div class="border-r border-[#222] px-10 pb-10 lg:px-16 lg:pb-16 flex flex-col justify-start pt-[12vh] lg:pt-[15vh]">
    <div class="text-[#a78bfa] text-xs font-mono mb-8 tracking-wide">
      &lt; Free &amp; Open Source · MIT &gt;
    </div>

    <h1 class="text-5xl lg:text-6xl xl:text-7xl font-bold text-white leading-[1.05] mb-6">
      See What<br />Your App<br />Is Doing.
    </h1>

    <div class="bg-[#7c3aed] px-4 py-3 inline-block mb-8 w-fit">
      <span class="font-display text-3xl lg:text-4xl xl:text-5xl font-bold text-white">
        Instantly.
      </span>
    </div>

    <p class="text-[#888] text-base max-w-sm mb-10 leading-relaxed">
      A debug receiver for any language or runtime.
      Send objects, errors, SQL, and timers — watch them stream
      into the desktop app in real time.
    </p>

    <div class="flex items-center gap-3 flex-wrap mb-8">
      <a
        href="#downloads"
        class="border border-white px-5 py-2.5 text-black bg-white font-mono text-sm font-bold hover:bg-transparent hover:text-white transition-colors"
      >
        Download ↓
      </a>
      <a
        href="/docs/"
        class="border border-[#333] px-5 py-2.5 text-[#888] font-mono text-sm hover:border-white hover:text-white transition-colors"
      >
        Read the docs →
      </a>
    </div>

    <div class="flex items-center gap-4 text-xs font-mono text-[#555]">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-[#4ade80]"></span>
        <span>macOS · Windows · Linux</span>
      </div>
      <span class="text-[#333]">·</span>
      <a
        href="https://github.com/fanar-app/fanar"
        target="_blank"
        rel="noopener noreferrer"
        id="hero-star-count"
        class="hover:text-white transition-colors"
      >★ GitHub</a>
    </div>
  </div>

  <!-- Right cell: video -->
  <div class="hidden lg:flex items-stretch overflow-hidden">
    <div class="w-full flex flex-col">
      <div class="flex items-center gap-1.5 px-4 py-3 border-b border-[#222] bg-black">
        <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
        <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
        <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
        <span class="flex items-center gap-1.5 ml-3 text-xs font-mono text-[#555]">
          <span class="w-1.5 h-1.5 bg-[#4ade80] animate-pulse"></span>
          LIVE
        </span>
      </div>
      <div class="relative flex-1 overflow-hidden">
        <video
          src="/hero.mp4"
          poster="/screenshot.png"
          autoplay
          muted
          loop
          playsinline
          class="w-full h-full object-cover object-top"
        />
      </div>
    </div>
  </div>
</section>

<script>
  fetch('https://api.github.com/repos/fanar-app/fanar')
    .then(r => r.json())
    .then(data => {
      const el = document.getElementById('hero-star-count');
      if (el && typeof data.stargazers_count === 'number') {
        el.textContent = `★ ${data.stargazers_count.toLocaleString()} stars`;
      }
    })
    .catch(() => {}); // silent — fallback text "★ GitHub" is already set in HTML
</script>
