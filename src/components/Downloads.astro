---
const base = 'https://github.com/fanar-app/fanar/releases/latest/download';
const platforms = [
  { label: 'macOS Apple Silicon', file: 'fanar-darwin-arm64.zip',  badge: 'arm64' },
  { label: 'macOS Intel',          file: 'fanar-darwin-amd64.zip', badge: 'amd64' },
  { label: 'Windows',              file: 'fanar-windows-amd64.exe',badge: '.exe'  },
  { label: 'Linux',                file: 'fanar-linux-amd64',      badge: 'bin'   },
];
---

<section id="downloads" class="border-b border-[#222]">
  <div class="grid lg:grid-cols-2">
    <!-- Left: heading + description -->
    <div class="border-r border-[#222] p-10 lg:p-16 flex flex-col justify-center">
      <div class="text-[#a78bfa] text-xs font-mono mb-4">&lt; Downloads &gt;</div>
      <h2 class="text-4xl lg:text-5xl font-bold text-white leading-tight mb-6">
        Download Fanar.<br />Free, Always.
      </h2>
      <p class="text-[#555] font-mono text-sm leading-relaxed mb-6">
        No account required. No license keys.<br />
        Download, open, and start sending payloads.
      </p>
      <div class="flex items-center gap-2 text-xs font-mono text-[#555]">
        <span class="w-1.5 h-1.5 bg-[#4ade80]"></span>
        macOS · Windows · Linux
      </div>
    </div>

    <!-- Right: download links -->
    <div class="flex flex-col divide-y divide-[#222]">
      {platforms.map(p => (
        <a
          href={`${base}/${p.file}`}
          class="flex items-center justify-between px-10 py-5 hover:bg-[#0a0a0a] transition-colors group"
        >
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-[#555] border border-[#222] px-2 py-0.5">{p.badge}</span>
            <span class="font-mono text-sm text-white">{p.label}</span>
          </div>
          <span class="font-mono text-xs text-[#555] group-hover:text-[#a78bfa] transition-colors">↓ Download</span>
        </a>
      ))}
      <div class="mt-auto border-t border-[#222] px-10 py-5 flex items-center gap-3">
        <span class="w-1.5 h-1.5 bg-[#4ade80] shrink-0"></span>
        <span class="font-mono text-xs text-[#555]">Latest release from GitHub — checksums verified</span>
      </div>
    </div>
  </div>
</section>
