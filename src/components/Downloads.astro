---
const base = 'https://github.com/fanar-app/fanar/releases/latest/download';
const platforms = [
  { label: 'macOS Apple Silicon', file: 'fanar-darwin-arm64.zip',  badge: 'arm64' },
  { label: 'macOS Intel',          file: 'fanar-darwin-amd64.zip', badge: 'amd64' },
  { label: 'Windows',              file: 'fanar-windows-amd64.exe',badge: '.exe'  },
  { label: 'Linux',                file: 'fanar-linux-amd64',      badge: 'bin'   },
];
---

<section id="downloads" class="border-b border-[var(--border)]">
  <div class="grid lg:grid-cols-2">
    <!-- Left: heading + description -->
    <div class="border-r border-[var(--border)] p-10 lg:p-16 flex flex-col justify-center">
      <div class="text-[var(--accent-text)] text-xs font-mono mb-4">&lt; Downloads &gt;</div>
      <h2 class="text-4xl lg:text-5xl font-bold text-[var(--text)] leading-tight mb-6">
        Download Fanar.<br />Free, Always.
      </h2>
      <p class="text-[var(--text-faint)] font-mono text-sm leading-relaxed mb-6">
        No account required. No license keys.<br />
        Download, open, and start sending payloads.
      </p>
      <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-faint)]">
        <span class="w-1.5 h-1.5 bg-[var(--green)]"></span>
        macOS · Windows · Linux
      </div>
    </div>

    <!-- Right: download links -->
    <div class="flex flex-col divide-y divide-[var(--border)]">
      {platforms.map(p => (
        <a
          href={`${base}/${p.file}`}
          class="flex items-center justify-between px-10 py-5 hover:bg-[var(--bg-hover)] transition-colors group"
        >
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs text-[var(--text-faint)] border border-[var(--border)] px-2 py-0.5">{p.badge}</span>
            <span class="font-mono text-sm text-[var(--text)]">{p.label}</span>
          </div>
          <span class="font-mono text-xs text-[var(--text-faint)] group-hover:text-[var(--accent-text)] transition-colors">↓ Download</span>
        </a>
      ))}
      <div class="mt-auto border-t border-[var(--border)] px-10 py-5 flex items-center gap-3">
        <span class="w-1.5 h-1.5 bg-[var(--green)] shrink-0"></span>
        <span class="font-mono text-xs text-[var(--text-faint)]">Latest release from GitHub — checksums verified</span>
      </div>
    </div>
  </div>
</section>
