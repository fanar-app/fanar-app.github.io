---
import DocsLayout from '../../components/DocsLayout.astro';
import { Code } from 'astro:components';
---

<DocsLayout title="PHP" section="php">
  <h1>PHP</h1>
  <p class="lead">The Fanar PHP client sends payloads over HTTP. Call the static methods anywhere in your code — controllers, services, console commands, or jobs.</p>

  <h2>Installation</h2>
  <Code code={`composer require fanar/fanar`} lang="bash" theme="github-dark" />

  <h2>Basic usage</h2>
  <Code code={`<?php
use Fanar\\Fanar;

// String / primitive log
Fanar::log('request received');

// Any value — arrays, objects, scalars
Fanar::dump(['user' => $user, 'orders' => $orders]);
Fanar::dump($response->toArray());

// Exceptions with stack trace
Fanar::exception($e);

// SQL with bindings and duration
Fanar::query($sql, [
  'bindings' => $bindings,
  'duration' => $durationMs,
]);`} lang="php" theme="github-dark" />

  <h2>Methods</h2>
  <table>
    <tr><th>Method</th><th>Description</th></tr>
    <tr><td>Fanar::log($value)</td><td>Send a string, number, or boolean as a log entry</td></tr>
    <tr><td>Fanar::dump($value)</td><td>Send any value — rendered as a collapsible tree</td></tr>
    <tr><td>Fanar::exception($e)</td><td>Send a <code>Throwable</code> with full stack trace</td></tr>
    <tr><td>Fanar::query($sql, $meta)</td><td>Send a SQL query with optional bindings and duration</td></tr>
  </table>

  <h2>Named timers</h2>
  <p>Measure any block of code with a named timer. Call <code>stop()</code> to send the elapsed time to the app.</p>
  <Code code={`<?php
use Fanar\\Fanar;

$t = Fanar::time('import');
importProducts($csv);
$t->stop();  // sends duration to the app`} lang="php" theme="github-dark" />

  <h2>Configuration</h2>
  <p>By default the client connects to <code>localhost:23517</code>. Configure once at boot time.</p>
  <Code code={`<?php
use Fanar\\Fanar;

Fanar::configure([
  'host' => '192.168.1.5',
  'port' => 9913,
]);`} lang="php" theme="github-dark" />
</DocsLayout>
